# Ambiente dos testes automatizados (npm test).
# Usa um banco separado (agrosense_test) no mesmo PostgreSQL do docker-compose.yml,
# para que os testes possam apagar e recriar os dados sem afetar o banco de desenvolvimento.
NODE_ENV=test
DATABASE_URL=postgresql://agrosense:agrosense@localhost:5432/agrosense_test?schema=public
JWT_SECRET=segredo-usado-somente-nos-testes
CORS_ORIGIN=http://localhost:5173
# Os testes simulam o Open-Meteo; nenhuma chamada real sai para a internet.
OPEN_METEO_URL=http://open-meteo.teste/v1/forecast
