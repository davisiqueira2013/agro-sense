# Porta em que a API escuta
PORT=3333

# Origem(ns) do frontend liberada(s) no CORS, separadas por vírgula
CORS_ORIGIN=http://localhost:5173

# Conexão com o PostgreSQL do docker-compose.yml (usada pelo Prisma na próxima etapa)
DATABASE_URL=postgresql://agrosense:agrosense@localhost:5432/agrosense?schema=public

# Segredo para assinar os tokens JWT (troque por um valor longo e aleatório)
JWT_SECRET=troque-este-segredo
